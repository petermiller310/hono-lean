        {"method": "GET", "pattern": "/students/:id", "handler": "same"},
        {"method": "GET", "pattern": "/students/:id", "handler": "same"},
        {"method": "ALL", "pattern": "/students/*", "handler": "same"}
      ],
      "steps": [
        {"op": "lookup", "request": {"method": "GET", "path": "/students/s1"}, "expected": [{"registration": 0, "handler": "same", "params": {"id": "s1"}}, {"registration": 1, "handler": "same", "params": {"id": "s1"}}, {"registration": 2, "handler": "same", "params": {}}]}
      ]
    },
    {
      "id": "methods-and-all",
      "why": "ALL adds a match; it does not replace an exact method match.",
      "routes": [
        {"method": "ALL", "pattern": "/students", "handler": "all"},
        {"method": "GET", "pattern": "/students", "handler": "get"},
        {"method": "HEAD", "pattern": "/students", "handler": "head"},
        {"method": "OPTIONS", "pattern": "/students", "handler": "options"},
        {"method": "PURGE", "pattern": "/students", "handler": "purge"}
      ],
      "steps": [
        {"op": "lookup", "request": {"method": "GET", "path": "/students"}, "expected": [{"registration": 0, "handler": "all", "params": {}}, {"registration": 1, "handler": "get", "params": {}}]},
        {"op": "lookup", "request": {"method": "HEAD", "path": "/students"}, "expected": [{"registration": 0, "handler": "all", "params": {}}, {"registration": 2, "handler": "head", "params": {}}]},
        {"op": "lookup", "request": {"method": "OPTIONS", "path": "/students"}, "expected": [{"registration": 0, "handler": "all", "params": {}}, {"registration": 3, "handler": "options", "params": {}}]},
        {"op": "lookup", "request": {"method": "PURGE", "path": "/students"}, "expected": [{"registration": 0, "handler": "all", "params": {}}, {"registration": 4, "handler": "purge", "params": {}}]},
        {"op": "lookup", "request": {"method": "POST", "path": "/students"}, "expected": [{"registration": 0, "handler": "all", "params": {}}]}
      ]
    },
    {
      "id": "no-head-fallback",
      "why": "Raw router matching does not apply the HTTP application HEAD fallback.",
