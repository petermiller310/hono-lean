        {"op": "register", "route": {"method": "GET", "pattern": "/students/:id", "handler": "read"}, "expectedRegistration": 2},
        {"op": "lookup", "request": {"method": "GET", "path": "/students/s4"}, "expected": [{"registration": 0, "handler": "read", "params": {"id": "s4"}}, {"registration": 2, "handler": "read", "params": {"id": "s4"}}]}
