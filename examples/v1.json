        {"op": "lookup", "request": {"method": "GET", "path": "/students/s1"}, "expected": [{"registration": 1, "handler": "global", "params": {}}, {"registration": 2, "handler": "students", "params": {}}, {"registration": 3, "handler": "student", "params": {"id": "s1"}}]}
