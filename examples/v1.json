{
  "fixtureVersion": 1,
  "baseline": {"repository": "https://github.com/honojs/hono", "revision": "5ca49b0720755c585c9a9835f0a479ceea36fb52", "router": "TrieRouter"},
  "notes": [
    "Expected is the normative hono-lean result. These examples are not proofs.",
    "baselineExpected records one exact pinned-Hono difference; it does not weaken expected.",
    "Each scenario starts with a fresh router; initial routes assign zero-based ordinals.",
    "Retained lookup results must still equal their expected values after later steps.",
    "Rejected inputs are adapter requirements; Hono may accept inputs outside this domain."
  ],
  "scenarios": [
    {
      "id": "empty-table",
      "why": "No registrations means no matches, including at the root.",
      "routes": [
      ],
      "steps": [
        {"op": "lookup", "request": {"method": "GET", "path": "/"}, "expected": []},
        {"op": "lookup", "request": {"method": "POST", "path": "/students"}, "expected": []}
      ]
    },
    {
      "id": "root-is-exact",
      "why": "The root is an empty path, not a catch-all.",
      "routes": [
        {"method": "GET", "pattern": "/", "handler": "root"}
      ],
      "steps": [
        {"op": "lookup", "request": {"method": "GET", "path": "/"}, "expected": [{"registration": 0, "handler": "root", "params": {}}]},
        {"op": "lookup", "request": {"method": "GET", "path": "/students"}, "expected": []},
        {"op": "lookup", "request": {"method": "POST", "path": "/"}, "expected": []}
      ]
    },
    {
      "id": "literal-is-whole-path",
      "why": "Exact paths do not match shorter or longer paths.",
      "routes": [
        {"method": "GET", "pattern": "/students/new", "handler": "new"}
      ],
      "steps": [
        {"op": "lookup", "request": {"method": "GET", "path": "/students/new"}, "expected": [{"registration": 0, "handler": "new", "params": {}}]},
        {"op": "lookup", "request": {"method": "GET", "path": "/students"}, "expected": []},
        {"op": "lookup", "request": {"method": "GET", "path": "/students/new/extra"}, "expected": []},
        {"op": "lookup", "request": {"method": "GET", "path": "/Students/new"}, "expected": []}
      ]
    },
    {
      "id": "overlap-keeps-all-matches",
      "why": "A literal does not suppress a parameter or wildcard match.",
      "routes": [
        {"method": "ALL", "pattern": "/students/*", "handler": "log"},
        {"method": "GET", "pattern": "/students/:id", "handler": "read"},
        {"method": "GET", "pattern": "/students/new", "handler": "new"}
      ],
      "steps": [
        {"op": "lookup", "request": {"method": "GET", "path": "/students/new"}, "expected": [{"registration": 0, "handler": "log", "params": {}}, {"registration": 1, "handler": "read", "params": {"id": "new"}}, {"registration": 2, "handler": "new", "params": {}}]},
        {"op": "lookup", "request": {"method": "POST", "path": "/students/new"}, "expected": [{"registration": 0, "handler": "log", "params": {}}]},
        {"op": "lookup", "request": {"method": "HEAD", "path": "/students/new"}, "expected": [{"registration": 0, "handler": "log", "params": {}}]}
      ]
    },
    {
      "id": "order-follows-registration",
      "why": "Traversal specificity cannot reorder registrations.",
      "routes": [
        {"method": "GET", "pattern": "/students/new", "handler": "new"},
        {"method": "ALL", "pattern": "/students/*", "handler": "log"},
        {"method": "GET", "pattern": "/students/:id", "handler": "read"}
      ],
      "steps": [
        {"op": "lookup", "request": {"method": "GET", "path": "/students/new"}, "expected": [{"registration": 0, "handler": "new", "params": {}}, {"registration": 1, "handler": "log", "params": {}}, {"registration": 2, "handler": "read", "params": {"id": "new"}}]}
      ]
    },
    {
      "id": "multiple-captures",
      "why": "Each parameter binds one segment under its own name.",
