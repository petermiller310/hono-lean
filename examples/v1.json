        {"method": "GET", "pattern": "/students/:studentId/worksheets/:worksheetId", "handler": "worksheet"}
      ],
      "steps": [
        {"op": "lookup", "request": {"method": "GET", "path": "/students/s1/worksheets/w2"}, "expected": [{"registration": 0, "handler": "worksheet", "params": {"studentId": "s1", "worksheetId": "w2"}}]},
        {"op": "lookup", "request": {"method": "GET", "path": "/students/s1/worksheets"}, "expected": []},
        {"op": "lookup", "request": {"method": "GET", "path": "/students/s1/worksheets/w2/extra"}, "expected": []}
      ]
    },
    {
      "id": "same-shape-different-names",
      "why": "Routes may share a shape without sharing capture names.",
      "routes": [
        {"method": "GET", "pattern": "/students/:studentId", "handler": "student"},
        {"method": "GET", "pattern": "/students/:id", "handler": "shortName"}
      ],
      "steps": [
        {"op": "lookup", "request": {"method": "GET", "path": "/students/s1"}, "expected": [{"registration": 0, "handler": "student", "params": {"studentId": "s1"}}, {"registration": 1, "handler": "shortName", "params": {"id": "s1"}}]}
      ]
    },
    {
      "id": "branch-capture-isolation",
      "why": "A general branch cannot leak keys into a literal branch.",
      "routes": [
        {"method": "GET", "pattern": "/:kind/:id", "handler": "general"},
