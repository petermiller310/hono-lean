        {"method": "GET", "pattern": "/students", "handler": "exact"}
      ],
      "steps": [
        {"op": "lookup", "request": {"method": "GET", "path": "/students"}, "expected": [{"registration": 0, "handler": "prefix", "params": {}}, {"registration": 1, "handler": "exact", "params": {}}]},
