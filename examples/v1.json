      ],
      "steps": [
        {"op": "lookup", "request": {"method": "HEAD", "path": "/students"}, "expected": []},
        {"op": "lookup", "request": {"method": "GET", "path": "/students"}, "expected": [{"registration": 0, "handler": "get", "params": {}}]}
      ]
    },
    {
      "id": "terminal-wildcard",
