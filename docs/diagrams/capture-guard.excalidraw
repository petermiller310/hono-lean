      "boundElements": null,
      "updated": 1792890312005,
      "created": 1792890312005,
      "link": null,
      "locked": false,
      "text": "Own means a descriptor exists: undefined, false, read-only and accessors all skip. No getter is invoked.\nInherited properties take the write path; a successful write does not always create a capture.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Own means a descriptor exists: undefined, false, read-only and accessors all skip. No getter is invoked.\nInherited properties take the write path; a successful write does not always create a capture.",
      "autoResize": true,
      "lineHeight": 1.15,
      "labelPosition": null
    },
