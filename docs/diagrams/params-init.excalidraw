      "boundElements": null,
      "updated": 1792892610844,
      "created": 1792892610843,
      "link": null,
      "locked": false,
      "text": "Identity is the branch test, not emptiness. A distinct empty object takes the copy arm.\nA shallow copy keeps object/array/self references; readonly source fields become ordinary writable data.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Identity is the branch test, not emptiness. A distinct empty object takes the copy arm.\nA shallow copy keeps object/array/self references; readonly source fields become ordinary writable data.",
