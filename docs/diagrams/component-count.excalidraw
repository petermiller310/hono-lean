      "link": null,
      "locked": false,
      "text": "A is tracked even on null results; per-exec arrays are projected out.\nNative controls cannot observe unreachable A. Instrumented clones\nrecord returned matches separately. Neither proves engine adequacy.",
      "fontSize": 18,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "A is tracked even on null results; per-exec arrays are projected out.\nNative controls cannot observe unreachable A. Instrumented clones\nrecord returned matches separately. Neither proves engine adequacy.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
