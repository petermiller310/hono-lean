      "seed": 1795681102,
      "version": 2,
      "versionNonce": 918460622,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792815330491,
      "created": 1792815330491,
      "link": null,
      "locked": false,
      "text": "Literal characters stay exact.\nParameter names are identifiers;\nall names within a route are unique.",
      "fontSize": 23,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Literal characters stay exact.\nParameter names are identifiers;\nall names within a route are unique.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "jpQ850XQV_y-pwS-DYTsv",
      "type": "text",
      "x": 840,
      "y": 590,
      "width": 371.3534000000002,
      "height": 86.25,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a9",
      "roundness": null,
      "seed": 439990418,
      "version": 2,
      "versionNonce": 212771602,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792815330491,
      "created": 1792815330491,
      "link": null,
      "locked": false,
      "text": "The final whole * permits\nzero or more remaining segments.\nIt adds no parameter binding.",
      "fontSize": 23,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The final whole * permits\nzero or more remaining segments.\nIt adds no parameter binding.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "M8W6EKL8JxOFhW6ijR_YZ",
      "type": "text",
      "x": 70,
      "y": 795,
      "width": 533.125,
      "height": 62.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aA",
      "roundness": null,
      "seed": 164188558,
      "version": 2,
      "versionNonce": 1431195406,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792815330491,
      "created": 1792815330491,
      "link": null,
      "locked": false,
      "text": "Root: / → empty prefix, suffix false\nAliases: * and /* → empty prefix, suffix true",
      "fontSize": 25,
      "baseFontSize": null,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Root: / → empty prefix, suffix false\nAliases: * and /* → empty prefix, suffix true",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "DYmJE3Gx5wgUavIadvbkj",
      "type": "text",
      "x": 70,
      "y": 965,
      "width": 837.9130000000005,
      "height": 57.5,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aB",
      "roundness": null,
      "seed": 1331222098,
      "version": 2,
      "versionNonce": 684486866,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1792815330491,
      "created": 1792815330491,
      "link": null,
      "locked": false,
      "text": "Reject: /:id/:id    /a/*/b    /a/**    /:id?    /a/\nIndependent grammar ↔ parser success with these exact components and flag.",
      "fontSize": 23,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Reject: /:id/:id    /a/*/b    /a/**    /:id?    /a/\nIndependent grammar ↔ parser success with these exact components and flag.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
