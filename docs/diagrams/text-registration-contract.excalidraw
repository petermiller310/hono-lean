      "updated": 1792816629371,
      "created": 1792816629371,
      "link": null,
      "locked": false,
      "text": "Repeat the same step:\nvalid records append once;\ninvalid records retain state.\nThe trace theorem covers any\nfinite sequence of attempts.",
      "fontSize": 23,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Repeat the same step:\nvalid records append once;\ninvalid records retain state.\nThe trace theorem covers any\nfinite sequence of attempts.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
