      "boundElements": null,
      "updated": 1792888735866,
      "created": 1792888653449,
      "link": null,
      "locked": false,
      "text": "Yes: reuse the existing array\nSkip parts, len and allocation\nNo validation or repair",
      "fontSize": 20,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "center",
