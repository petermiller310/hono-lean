      "updated": 1792888683110,
      "created": 1792888683110,
      "link": null,
      "locked": false,
      "text": "An empty array is truthy. Its absent entry is undefined, so slice starts at 0: the whole path.\nA wrong cache is reused too. Offsets and slicing count UTF16 units, including lone surrogates.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "An empty array is truthy. Its absent entry is undefined, so slice starts at 0: the whole path.\nA wrong cache is reused too. Offsets and slicing count UTF16 units, including lone surrogates.",
      "autoResize": true,
