      "updated": 1792813503953,
      "created": 1792813503953,
      "link": null,
      "locked": false,
      "text": "The composed text-to-match-list contract is now proved.\nJSON decoding/encoding and the CLI remain tested boundaries.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Method and route-pattern parsing, JSON decoding/encoding, and the CLI\nremain tested. This is not yet an end-to-end JSON correctness theorem.",
