      "link": null,
      "locked": false,
      "text": "Text-record parsing and\nbuild/registration/lookup\nnow compose into one proof.",
      "fontSize": 22,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Assumes valid typed routes\nand a typed method.\nThese remain separate theorems.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
