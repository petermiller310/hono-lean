      "created": 1792814778902,
      "link": null,
      "locked": false,
      "text": "Selector.all can match GET, HEAD, PURGE, and every other supported method.\nIt is not a new request method and does not turn HEAD into GET.",
      "fontSize": 24,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Selector.all can match GET, HEAD, PURGE, and every other supported method.\nIt is not a new request method and does not turn HEAD into GET.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
